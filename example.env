# Open CRM environment configuration example.
#
# Copy to `.env` and fill in real values for your deployment. Every value here
# is a safe placeholder. Third-party integrations (billing, email, telephony,
# SSO, AI) default to a FAKE/disabled provider so the app runs end-to-end in
# tests and deployments without external credentials. Switch a provider to its
# real name and supply credentials only when you are ready to wire it up.

# ── Core runtime ────────────────────────────────────────────────
DATABASE_URL=postgres://open_crm:open_crm@localhost:5432/open_crm?sslmode=disable
API_PORT=8080
WEB_PORT=5173
API_BASE_URL=http://localhost:8080
WEB_BASE_URL=http://localhost:5173
GO_ENV=development
NODE_ENV=development

# Comma-separated list of browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173

# Frontend build-time API base (read by Vite as VITE_API_BASE_URL).
VITE_API_BASE_URL=http://localhost:8080

# ── Billing / Subscriptions (1.0.x) ─────────────────────────────
# Provider selector. "fake" approves plan changes locally with no external
# calls and is the default for tests and unconfigured deployments. Set to
# "stripe" and provide the keys below to use real billing.
BILLING_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# ── Email & Communications (1.1.x) ──────────────────────────────
# Open CRM has TWO separate email paths:
#
# 1. SYSTEM email (platform -> CRM users): invites, password setup, notifications.
#    Sent via Postmark below. "fake" logs in-process instead of sending.
# 2. USER email (CRM user -> their customers): each user connects their own
#    mailbox (SMTP) under Settings > My Email, so messages send as the user.
#    This is configured per-user in the app, not here — but it requires
#    CREDENTIAL_ENCRYPTION_KEY (below) so stored SMTP passwords are encrypted.
#
# Postmark is the same transactional provider used by the Mendola customer
# panel, so the same Server API Token works.
EMAIL_PROVIDER=postmark
EMAIL_FROM_NAME=Open CRM
# Postmark: create a "Server" in Postmark and copy its Server API Token. The
# message stream should match the stream configured in Postmark (e.g. outbound).
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=support@mendola.tech
POSTMARK_MESSAGE_STREAM=outbound

# Encryption key for per-user mailbox (SMTP) passwords. Required for users to
# connect their own email under Settings > My Email. Generate a 32-byte key:
#   openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

# OAuth for two-way mailbox sync (Gmail / Microsoft 365). The app can report
# whether OAuth clients are configured; callback/token exchange is wired later.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# ── Telephony & SMS (1.2.x) ─────────────────────────────────────
# "fake" records calls/SMS without contacting a carrier.
TELEPHONY_PROVIDER=fake
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── SSO (1.0.7 / 2.0) ───────────────────────────────────────────
# "fake" disables SSO and keeps password auth only.
SSO_PROVIDER=fake
SAML_METADATA_URL=
SAML_ENTITY_ID=
SCIM_BEARER_TOKEN=

# ── AI & Intelligence (1.7.x) ───────────────────────────────────
# "fake" returns deterministic stub completions with no external inference.
AI_PROVIDER=fake
AI_API_KEY=
AI_MODEL=

# ── Object storage (attachments, exports, 0.9.4) ────────────────
# "fake" uses local disk under STORAGE_LOCAL_DIR instead of a cloud bucket.
STORAGE_PROVIDER=fake
STORAGE_LOCAL_DIR=./.localdata/storage
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
