# Open CRM environment configuration example.
#
# Copy to `.env` and fill in real values for your deployment. Every value here
# is a safe placeholder. Third-party integrations (billing, email, telephony,
# SSO, AI) default to a FAKE/disabled provider so the app runs end-to-end in
# tests and deployments without external credentials. Switch a provider to its
# real name and supply credentials only when you are ready to wire it up.

# ── Core runtime ────────────────────────────────────────────────
DATABASE_URL=postgres://open_crm:open_crm@localhost:5432/open_crm?sslmode=disable
API_PORT=8080
WEB_PORT=5173
API_BASE_URL=http://localhost:8080
WEB_BASE_URL=http://localhost:5173
GO_ENV=development
NODE_ENV=development

# The deployment workflow supplies the immutable Git commit release ID. Keep
# contract migrations disabled during ordinary deploys; see the operations
# runbook before enabling them for an approved no-rollback maintenance window.
ALLOW_CONTRACT_MIGRATIONS=false

# Comma-separated list of browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173

# Protected Prometheus endpoint (`GET /metrics`). Leave blank to hide the route.
# Generate at least 32 random characters: openssl rand -hex 32
METRICS_BEARER_TOKEN=
# Container-internal read-only backup evidence path; normally do not override.
BACKUP_STATUS_PATH=/run/open-crm/backup-status

# Frontend build-time API base (read by Vite as VITE_API_BASE_URL).
VITE_API_BASE_URL=http://localhost:8080

# ── Billing / Subscriptions (1.0.x) ─────────────────────────────
# "fake" approves plan changes locally without external calls and remains the
# safe self-host/development default; it does not enforce hosted trials, plan
# limits, or subscription suspension. "stripe" enables backend-created hosted
# Checkout/customer-portal sessions and the signed webhook lifecycle. Do not
# enable it until the Stripe account, portal, webhook endpoint, recurring Price
# IDs, and an approved test-mode acceptance run are configured. WEB_BASE_URL
# must be the exact browser origin used for Checkout return URLs.
BILLING_PROVIDER=fake
# Use a test key with a test webhook secret and test Prices, or a live key with
# their live equivalents; the API rejects test/live webhook mode mismatches.
STRIPE_SECRET_KEY=
# Endpoint-specific signing secret for POST /api/billing/webhooks/stripe. This
# is not an API key and must not be shared with another endpoint/environment.
STRIPE_WEBHOOK_SECRET=
# Exact recurring Stripe Price IDs. Leave a plan blank to hide hosted Checkout
# for that plan. Hosted Checkout needs no browser publishable key.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# ── Email & Communications (1.1.x) ──────────────────────────────
# Open CRM has TWO separate email paths:
#
# 1. SYSTEM email (platform -> CRM users): workspace verification, invites,
#    password setup/recovery, and notifications. Sent via Postmark below.
#    "fake" logs in-process; local verification/reset links are available only
#    with an explicit GO_ENV=development or GO_ENV=test runtime. Never run an
#    internet-facing deployment in either mode.
# 2. USER email (CRM user -> their customers): each user connects their own
#    mailbox under Settings > My Email. Generic accounts send with SMTP;
#    Google/Microsoft accounts send and sync through their OAuth APIs. Per-user
#    secrets are encrypted with CREDENTIAL_ENCRYPTION_KEY below.
#
# Postmark is the same transactional provider used by the Mendola customer
# panel, so the same Server API Token works.
EMAIL_PROVIDER=postmark
EMAIL_FROM_NAME=Open CRM
# Postmark: create a "Server" in Postmark and copy its Server API Token. The
# message stream should match the stream configured in Postmark (e.g. outbound).
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=support@mendola.tech
POSTMARK_MESSAGE_STREAM=outbound
# Generate a dedicated username and a password with at least 32 characters.
# Configure Bounce and SpamComplaint webhooks for this server/message stream at:
#   https://<username>:<password>@<api-host>/api/email/webhooks/postmark
# Leave "Include message content" disabled. The endpoint stays hidden with 404
# until both values are configured.
POSTMARK_WEBHOOK_USERNAME=
POSTMARK_WEBHOOK_PASSWORD=

# Encryption key for per-user SMTP/IMAP passwords and OAuth tokens. Required for
# users to connect email under Settings > My Email. Generate a 32-byte key:
#   openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

# OAuth for Gmail / Microsoft 365 outbound delivery and mailbox sync. Configure
# provider redirect URIs to
# `${API_BASE_URL}/api/me/email-sync/oauth/{provider}/callback`. Google requests
# delegated gmail.readonly + gmail.send; Microsoft requests delegated Mail.Read
# + Mail.Send plus offline_access. Existing read-only grants must reconnect.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# ── Telephony & SMS (1.2.x) ─────────────────────────────────────
# "fake" records calls/SMS without contacting a carrier and is the only
# implemented provider. Twilio variables reserve the intended contract.
TELEPHONY_PROVIDER=fake
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Calendar / Meetings (1.2.x) ─────────────────────────────────
# "fake" records meetings and availability without contacting Google/Microsoft
# and is the only implemented calendar provider.
CALENDAR_PROVIDER=fake

# ── SSO (1.0.7 / 2.0) ───────────────────────────────────────────
# SSO is not implemented. These variables reserve the planned contract; password
# authentication remains the only login provider.
SSO_PROVIDER=fake
SAML_METADATA_URL=
SAML_ENTITY_ID=
SCIM_BEARER_TOKEN=

# ── AI & Intelligence (1.7.x) ───────────────────────────────────
# AI is outside the convergence scope and is not implemented. These variables
# reserve a possible future contract.
AI_PROVIDER=fake
AI_API_KEY=
AI_MODEL=

# ── Object storage (attachments, exports, 0.9.4) ────────────────
# Object storage is not implemented. These variables reserve the planned
# attachment/export contract; current exports stream from the API.
STORAGE_PROVIDER=fake
STORAGE_LOCAL_DIR=./.localdata/storage
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Encrypted database backups (production operations) ─────────
# Backup scripts reject local repositories unless the disposable acceptance
# test explicitly opts in. Configure a Restic-supported off-host repository.
# Example: s3:https://s3.us-east-1.amazonaws.com/example/open-crm
RESTIC_REPOSITORY=
# Keep the password and backend credentials outside the repository, owned by
# the deployment user, and chmod 600. Losing the password makes backups
# unrecoverable. RESTIC_BACKEND_ENV_FILE can contain AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY, and provider-specific variables understood by Restic.
RESTIC_PASSWORD_FILE=
RESTIC_BACKEND_ENV_FILE=
RESTIC_IMAGE=restic/restic:0.19.1@sha256:136600b6ff6843d61d355f7f71f460a166429f35de6fd11b568fece3c9a4d510
BACKUP_HOST_TAG=open-crm-production
BACKUP_TAG=open-crm-postgres
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=5
BACKUP_KEEP_MONTHLY=12
# Defaults to <deployment>/var/backup-status when blank.
BACKUP_STATUS_DIR=
